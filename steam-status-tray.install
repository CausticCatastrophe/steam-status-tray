post_install() {
  echo
  echo "  Steam Status Tray is installed."
  echo
  echo "  To start it now: press the Windows key, type"
  echo "  'Steam Status Tray' and press Enter (or log out and in)."
  echo
  echo "  After that it starts on its own at every login, and"
  echo "  the icon shows whenever Steam is running."
  echo
}

post_upgrade() {
  echo
  echo "  Steam Status Tray updated. Log out and back in to use"
  echo "  the new version."
  echo
}
