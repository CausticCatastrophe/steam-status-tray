post_install() {
  echo
  echo "  Steam Status Tray is installed. It starts on its own at"
  echo "  every login, and the icon shows whenever Steam is running."
  echo
}

pre_remove() {
  # Stop any running copies so the icon goes away with the package
  pkill -f '^python3? /usr/bin/steam-status-tray' || true
}
