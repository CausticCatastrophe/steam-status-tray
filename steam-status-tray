#!/usr/bin/env python3
"""Tray icon with Steam status options and the usual Windows tray items."""
import ctypes
import ctypes.util
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from PyQt6.QtCore import QTimer
from PyQt6.QtDBus import QDBusInterface
from PyQt6.QtGui import QAction, QActionGroup, QColor, QIcon, QPainter
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon

STATUSES = ["Online", "Away", "Invisible", "Offline"]

# Steam's ePersonaState values, as written to localconfig.vdf
PERSONA_STATES = {1: "Online", 3: "Away", 7: "Invisible", 0: "Offline"}

USERDATA = Path.home() / ".local/share/Steam/userdata"


def current_status():
    """Read the live persona state from the most recently used account."""
    configs = list(USERDATA.glob("*/config/localconfig.vdf"))
    if not configs:
        return None
    newest = max(configs, key=lambda p: p.stat().st_mtime)
    try:
        text = newest.read_text(errors="ignore")
    except OSError:
        return None
    m = re.search(r'ePersonaState\\":(\d+)', text)
    return PERSONA_STATES.get(int(m.group(1))) if m else None


def parse_vdf(text):
    """Parse Valve's text KeyValues format into nested dicts (keys
    lowercased). Good enough for localconfig.vdf."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    root, stack, key = {}, [], None
    node = root
    for quoted, brace in tokens:
        if brace == "{":
            child = {}
            node[key] = child
            stack.append(node)
            node, key = child, None
        elif brace == "}":
            node = stack.pop() if stack else root
            key = None
        elif key is None:
            key = quoted.lower()
        else:
            node[key] = quoted
            key = None
    return root


# --- Recently played games -------------------------------------------------
#
# Steam's own tray menu lists the 5 most recently played games. Its Linux
# menu (D-Bus, still running while its icon is hidden) gives the names in
# the user's language; localconfig.vdf gives app IDs by LastPlayed, in the
# same order. Icons are Steam's cached 32x32 game icons.

LIBRARY_CACHE = Path.home() / ".local/share/Steam/appcache/librarycache"
STEAM_SNI_PATH = "/org/ayatana/NotificationItem/steam"


def busctl_json(*args):
    try:
        out = subprocess.run(["busctl", "--user", "--json=short", *args],
                             capture_output=True, text=True, timeout=2)
        return json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def steam_menu_games():
    """[(dbusmenu item id, label)] for the games in Steam's own tray menu,
    plus the D-Bus service name, or ([], None) if it can't be read."""
    items = busctl_json(
        "get-property", "org.kde.StatusNotifierWatcher",
        "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
        "RegisteredStatusNotifierItems")
    service = next((s.split("/", 1)[0] for s in (items or {}).get("data", [])
                    if s.endswith(STEAM_SNI_PATH)), None)
    if not service:
        return [], None
    layout = busctl_json("call", service, STEAM_SNI_PATH + "/Menu",
                         "com.canonical.dbusmenu", "GetLayout", "iias",
                         "0", "--", "-1", "0")
    games = []
    try:
        for child in layout["data"][1][2]:
            item_id, props, _ = child["data"]
            props = {k: v["data"] for k, v in props.items()}
            if props.get("type") == "separator":
                break  # games are the first group
            if props.get("label"):
                games.append((item_id, props["label"]))
    except (KeyError, IndexError, TypeError, ValueError):
        return [], None
    return games, service


def recent_app_ids():
    """App IDs from localconfig.vdf, most recently played first."""
    configs = list(USERDATA.glob("*/config/localconfig.vdf"))
    if not configs:
        return []
    newest = max(configs, key=lambda p: p.stat().st_mtime)
    try:
        vdf = parse_vdf(newest.read_text(errors="ignore"))
        apps = (vdf["userlocalconfigstore"]["software"]["valve"]
                ["steam"]["apps"])
    except (OSError, KeyError, TypeError):
        return []
    played = [(int(a.get("lastplayed", 0)), appid)
              for appid, a in apps.items()
              if isinstance(a, dict) and appid.isdigit()]
    return [appid for t, appid in sorted(played, reverse=True) if t > 0]


def game_icon(appid):
    """Steam's cached 32x32 icon for a game (a <sha1>.jpg), if any."""
    folder = LIBRARY_CACHE / appid
    try:
        icons = [p for p in folder.iterdir()
                 if re.fullmatch(r"[0-9a-f]{40}\.jpg", p.name)]
    except OSError:
        return QIcon()
    return QIcon(str(min(icons, key=lambda p: p.stat().st_size))) \
        if icons else QIcon()


def recent_games():
    """[(label, icon, launch)] matching Steam's own recent-games list."""
    menu_games, service = steam_menu_games()
    if not menu_games:
        return []
    ids = recent_app_ids()[:len(menu_games)]
    if len(ids) == len(menu_games):
        return [(label, game_icon(appid),
                 lambda a=appid: steam(f"steam://rungameid/{a}"))
                for (_, label), appid in zip(menu_games, ids)]
    # Lists don't line up: keep the names, launch through Steam's own menu
    return [(label, QIcon(),
             lambda i=item_id: subprocess.Popen(
                 ["busctl", "--user", "call", service,
                  STEAM_SNI_PATH + "/Menu", "com.canonical.dbusmenu",
                  "Event", "isvu", str(i), "clicked", "s", "", "0"],
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            for item_id, label in menu_games]


GROUPS = [
    [
        ("Store", "steam://store"),
        ("Library", "steam://open/games"),
        ("Community", "steam://url/CommunityHome"),
        ("Profile", "steam://url/SteamIDMyProfile"),
        ("Friends", "steam://open/friends"),
    ],
    [
        ("Downloads", "steam://open/downloads"),
        ("Screenshots", "steam://open/screenshots"),
        ("Settings", "steam://open/settings"),
        ("Big Picture", "steam://open/bigpicture"),
    ],
]


def steam_running():
    """True if a process named 'steam' is running."""
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if (proc / "comm").read_text().strip() == "steam":
                return True
        except OSError:
            continue
    return False


def steam(*args):
    subprocess.Popen(["steam", *args], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


# Plasma script: hide (HIDE=true) or restore Steam's own tray icon
STEAM_ICON_SCRIPT = """
const HIDE = %s;
for (const p of panels()) {
  for (const w of p.widgets("org.kde.plasma.systemtray")) {
    w.currentConfigGroup = ["General"];
    const split = k => String(w.readConfig(k, "")).split(",")
                         .filter(x => x);
    const hidden = split("hiddenItems").filter(x => x !== "steam");
    if (HIDE) hidden.push("steam");
    w.writeConfig("hiddenItems", hidden);
    w.writeConfig("shownItems",
                  split("shownItems").filter(x => x !== "steam"));
  }
}
"""


def set_steam_icon_hidden(hide):
    """On KDE Plasma, hide or restore Steam's own tray icon.

    Hidden while this tray runs so there's only one Steam icon; restored
    when it stops (including on uninstall). No-op outside Plasma.
    """
    shell = QDBusInterface("org.kde.plasmashell", "/PlasmaShell",
                           "org.kde.PlasmaShell")
    if shell.isValid():
        shell.call("evaluateScript",
                   STEAM_ICON_SCRIPT % ("true" if hide else "false"))


# --- Unread chats ---------------------------------------------------------
#
# Steam on Linux has a bug (steam-for-linux#10722): when a message arrives
# and no chat is open, Steam creates the chat window but never shows it.
# Steam logs the window's creation in webhelper.txt, and the hidden X11
# window's title is the friend's name. We list those as unread chats, and
# opening one maps the window and asks KWin to un-minimize and focus it.

WEBHELPER_LOG = Path.home() / ".local/share/Steam/logs/webhelper.txt"
CHAT_CREATED = re.compile(r"chat_ChatWindow_(\d+)_uid\d+.*?: Created window:"
                          r".*System window: (0x[0-9a-fA-F]+)")
CHAT_HIDDEN = re.compile(r"chat_ChatWindow_(\d+)_uid\d+.*?: WasHidden ([01])")
CHAT_CLOSED = re.compile(r"chat_ChatWindow_(\d+)_uid\d+.*?: "
                         r"Applying safe browser shutdown")
# A chat the user opens themselves is briefly hidden too; only count it
# as unread once it has stayed hidden this long.
UNREAD_AFTER = 1.5

KWIN_RAISE_SCRIPT = """
const title = %s;
for (const w of workspace.windowList()) {
  if (w.resourceClass === "steam" && w.caption === title) {
    w.minimized = false;
    workspace.activeWindow = w;
  }
}
"""


class X11:
    """Just enough of libX11 (via ctypes) to read a title and map a window.

    Steam runs under XWayland even in a Wayland session, so its windows
    are X11 windows. Any X error (e.g. the window is gone) is ignored.
    """

    def __init__(self):
        self.d = None
        lib = ctypes.util.find_library("X11")
        if not lib or not os.environ.get("DISPLAY"):
            return
        x = self.x = ctypes.cdll.LoadLibrary(lib)
        vp, ul = ctypes.c_void_p, ctypes.c_ulong
        x.XOpenDisplay.restype = vp
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        handler_t = ctypes.CFUNCTYPE(ctypes.c_int, vp, vp)
        self._on_error = handler_t(lambda d, e: 0)  # keep a reference
        x.XSetErrorHandler.argtypes = [handler_t]
        x.XSetErrorHandler(self._on_error)
        x.XInternAtom.restype = ul
        x.XInternAtom.argtypes = [vp, ctypes.c_char_p, ctypes.c_int]
        x.XGetWindowProperty.argtypes = [
            vp, ul, ul, ctypes.c_long, ctypes.c_long, ctypes.c_int, ul,
            ctypes.POINTER(ul), ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ul), ctypes.POINTER(ul),
            ctypes.POINTER(ctypes.POINTER(ctypes.c_ubyte))]
        x.XFree.argtypes = [vp]
        x.XMapRaised.argtypes = [vp, ul]
        x.XFlush.argtypes = [vp]
        self.d = x.XOpenDisplay(None)
        if self.d:
            self.net_wm_name = x.XInternAtom(self.d, b"_NET_WM_NAME", 0)

    def title(self, wid):
        """The window's _NET_WM_NAME, or None if it has none or is gone."""
        if not self.d:
            return None
        ul = ctypes.c_ulong
        a_type, a_fmt = ul(), ctypes.c_int()
        n, after = ul(), ul()
        data = ctypes.POINTER(ctypes.c_ubyte)()
        ok = self.x.XGetWindowProperty(
            self.d, wid, self.net_wm_name, 0, 1024, 0, 0,
            ctypes.byref(a_type), ctypes.byref(a_fmt), ctypes.byref(n),
            ctypes.byref(after), ctypes.byref(data))
        if ok != 0 or not data:
            return None
        try:
            return bytes(data[:n.value]).decode("utf-8", "replace") or None
        finally:
            self.x.XFree(data)

    def map_raised(self, wid):
        if self.d:
            self.x.XMapRaised(self.d, wid)
            self.x.XFlush(self.d)


def log_time(line):
    """A log line's '[YYYY-MM-DD HH:MM:SS]' stamp as epoch seconds."""
    try:
        return time.mktime(time.strptime(line[1:20], "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return time.time()


class ChatWatcher:
    """Follows webhelper.txt and tracks chat windows Steam left hidden."""

    def __init__(self):
        self.x11 = X11()
        self.windows = {}  # ChatWindow number -> {"wid", "hidden_since"}
        self.inode = None
        self.offset = 0
        self.partial = ""

    @property
    def enabled(self):
        return self.x11.d is not None

    def poll(self):
        if not self.enabled:
            return
        try:
            st = WEBHELPER_LOG.stat()
        except OSError:
            return
        if st.st_ino != self.inode or st.st_size < self.offset:
            # First read, or a new/rotated log (Steam restarted). Read it
            # all: chats left hidden earlier are still unread, and windows
            # that no longer exist drop out when their title can't be read.
            self.inode, self.offset, self.partial = st.st_ino, 0, ""
            self.windows.clear()
        if st.st_size == self.offset:
            return
        with open(WEBHELPER_LOG, "rb") as f:
            f.seek(self.offset)
            chunk = f.read()
        self.offset += len(chunk)
        lines = (self.partial + chunk.decode("utf-8", "replace")).split("\n")
        self.partial = lines.pop()
        for line in lines:
            self._handle(line)

    def _handle(self, line):
        if m := CHAT_CREATED.search(line):
            self.windows[m[1]] = {"wid": int(m[2], 16), "hidden_since": None}
        elif m := CHAT_HIDDEN.search(line):
            if m[1] in self.windows:
                self.windows[m[1]]["hidden_since"] = (
                    log_time(line) if m[2] == "1" else None)
        elif m := CHAT_CLOSED.search(line):
            self.windows.pop(m[1], None)

    def unread(self):
        """[(friend name, window id)] for chats Steam left hidden."""
        now, out = time.time(), []
        for key, w in list(self.windows.items()):
            since = w["hidden_since"]
            if since is None or now - since < UNREAD_AFTER:
                continue
            name = self.x11.title(w["wid"])
            if name is None:  # window is gone
                self.windows.pop(key, None)
                continue
            out.append((name, w["wid"]))
        return out

    def open(self, name, wid):
        """Show a hidden chat window and bring it to the front."""
        for w in self.windows.values():
            if w["wid"] == wid:
                w["hidden_since"] = None
        self.x11.map_raised(wid)
        # KWin needs a moment to start managing the newly mapped window
        QTimer.singleShot(300, lambda: kwin_run(
            KWIN_RAISE_SCRIPT % json.dumps(name)))

    def clear(self):
        self.windows.clear()


def kwin_run(source):
    """Run a one-off KWin script (KWin loads scripts from a file)."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or str(Path.home() / ".cache")
    fd, path = tempfile.mkstemp(prefix="steam-status-tray-", suffix=".js",
                                dir=runtime)
    with os.fdopen(fd, "w") as f:
        f.write(source)
    name = Path(path).stem
    scripting = QDBusInterface("org.kde.KWin", "/Scripting",
                               "org.kde.kwin.Scripting")
    reply = scripting.call("loadScript", path, name)
    args = reply.arguments()
    if args and isinstance(args[0], int) and args[0] >= 0:
        QDBusInterface("org.kde.KWin", f"/Scripting/Script{args[0]}",
                       "org.kde.kwin.Script").call("run")

    def cleanup():
        scripting.call("unloadScript", name)
        Path(path).unlink(missing_ok=True)

    QTimer.singleShot(2000, cleanup)


def with_badge(icon):
    """The icon with a red unread dot in the corner."""
    pm = icon.pixmap(64, 64)
    painter = QPainter(pm)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setPen(QColor("white"))
    painter.setBrush(QColor("#e0302f"))
    painter.drawEllipse(36, 0, 27, 27)
    painter.end()
    return QIcon(pm)


def take_over():
    """Take the per-user lock, replacing any older running instance.

    The lock file holds the owner's PID. A newer launch (e.g. after an
    update) stops the old instance so the new version takes its place.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    lock_dir = Path(runtime) if runtime else Path.home() / ".cache"
    lock_dir.mkdir(parents=True, exist_ok=True)
    try:
        # No O_TRUNC, and never follow a symlink planted at the lock path
        fd = os.open(lock_dir / "steam-status-tray.lock",
                     os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return  # can't lock; run anyway rather than refuse to start
    lock = os.fdopen(fd, "r+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        stop_old_instance(lock)
        for _ in range(50):  # wait up to 5s for it to exit
            time.sleep(0.1)
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                continue
        else:
            sys.exit(0)  # old instance won't go; leave it running
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()
    take_over.lock = lock  # held for the life of the process


def stop_old_instance(lock):
    """SIGTERM the PID in the lock file, if it really is this program."""
    lock.seek(0)
    try:
        pid = int(lock.read().strip())
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (ValueError, OSError):
        return
    if pid != os.getpid() and b"steam-status-tray" in cmdline:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def main():
    take_over()

    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    # Keep running while the icon is hidden (Steam closed)
    app.setQuitLockEnabled(False)
    app.setDesktopFileName("steam-status-tray")

    set_steam_icon_hidden(True)
    app.aboutToQuit.connect(lambda: set_steam_icon_hidden(False))
    # SIGTERM (uninstall, update takeover, logout) quits cleanly so the
    # icon is restored. Python only runs signal handlers between Qt
    # events, so a short no-op timer keeps that responsive.
    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    wake = QTimer()
    wake.timeout.connect(lambda: None)
    wake.start(250)

    menu = QMenu()
    status_group = QActionGroup(menu)
    status_group.setExclusive(True)
    status_actions = {}
    # Steam doesn't save "Offline" to localconfig.vdf (the stored value
    # stays at the last online state), so remember it ourselves: when
    # Offline is picked here, show Offline until the stored value changes.
    offline = {"on": False, "stored": None}

    def choose(name):
        offline["on"] = name == "Offline"
        offline["stored"] = current_status()
        steam(f"steam://friends/status/{name.lower()}")

    for name in STATUSES:
        act = QAction(name, menu, checkable=True)
        act.triggered.connect(lambda _, n=name: choose(n))
        status_group.addAction(act)
        menu.addAction(act)
        status_actions[name] = act

    def sync_status():
        name = current_status()
        if offline["on"]:
            if name == offline["stored"]:
                name = "Offline"
            else:
                offline["on"] = False  # status changed elsewhere
        if name in status_actions:
            status_actions[name].setChecked(True)

    sync_status()
    menu.aboutToShow.connect(sync_status)

    for group in GROUPS:
        menu.addSeparator()
        for name, url in group:
            menu.addAction(name).triggered.connect(
                lambda _, u=url: steam(u))

    menu.addSeparator()
    menu.addAction("Exit Steam").triggered.connect(
        lambda: steam("-shutdown"))

    plain_icon = QIcon.fromTheme("steam")
    badge_icon = with_badge(plain_icon)
    tray = QSystemTrayIcon(plain_icon)
    tray.setToolTip("Steam Status")
    tray.setContextMenu(menu)

    first_status = status_actions[STATUSES[0]]

    def separator():
        sep = QAction(menu)
        sep.setSeparator(True)
        return sep

    # Recently played games, between unread chats and the statuses
    game_actions = []

    def sync_games():
        for act in game_actions:
            menu.removeAction(act)
        game_actions.clear()
        for label, icon, launch in recent_games():
            act = QAction(icon, label, menu)
            act.triggered.connect(lambda _, f=launch: f())
            game_actions.append(act)
        if game_actions:
            game_actions.append(separator())
        menu.insertActions(first_status, game_actions)

    menu.aboutToShow.connect(sync_games)

    # Unread chats: listed at the top of the menu, badge on the icon
    chats = ChatWatcher()
    chat_actions = []
    shown = {"unread": None}

    def sync_chats():
        chats.poll()
        unread = chats.unread()
        key = [name for name, _ in unread]
        if key == shown["unread"]:
            return
        shown["unread"] = key
        for act in chat_actions:
            menu.removeAction(act)
        chat_actions.clear()
        for name, wid in unread:
            act = QAction(f"💬 {name}", menu)
            act.triggered.connect(
                lambda _, n=name, w=wid: open_chat(n, w))
            chat_actions.append(act)
        if chat_actions:
            chat_actions.append(separator())
        # Top of the menu: above the games (if any), else above statuses
        anchor = game_actions[0] if game_actions else first_status
        menu.insertActions(anchor, chat_actions)
        tray.setIcon(badge_icon if unread else plain_icon)
        tray.setToolTip(f"Steam Status — {len(unread)} unread chat"
                        f"{'' if len(unread) == 1 else 's'}"
                        if unread else "Steam Status")

    def open_chat(name, wid):
        chats.open(name, wid)
        sync_chats()

    def on_click(reason):
        if reason != QSystemTrayIcon.ActivationReason.Trigger:
            return
        unread = chats.unread()
        if unread:
            open_chat(*unread[0])
        else:
            steam("steam://open/friends")

    tray.activated.connect(on_click)
    menu.aboutToShow.connect(sync_chats)
    chat_timer = QTimer()
    chat_timer.timeout.connect(sync_chats)
    chat_timer.start(1000)

    # Only show the icon while Steam is running
    def sync_visibility():
        running = steam_running()
        if not running:
            offline["on"] = False  # Steam signs back in on next start
            chats.clear()
        tray.setVisible(running)

    sync_visibility()
    timer = QTimer()
    timer.timeout.connect(sync_visibility)
    timer.start(3000)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
